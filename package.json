{
  "name": "ux-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сервис для UX-исследований: конструктор тестов, шеринг, прохождение и результаты",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "baseui": "node scripts/sync-baseui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
